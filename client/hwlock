def _lease_of(out, requested):
    return requested or (out.get("holder") or {}).get("lease_s") or 1800


HEALTH_FLAGS = {"fail-if-down": bool, "exit-on-degraded": bool}


def _health_watch(res, owner, out, on_health, exit_on_degraded):
    """Start a HealthWatcher for a holder (run/hold) if the resource has probes. on_health(code, msg) is
    called when the holder must stop: down (6), its lease voided by a reboot (7), degraded with
    --exit-on-degraded (8). Other changes are printed as warnings."""
    hv = out.get("health")
    if not hv:
        return None

    def on_event(e, cur):
        k = e["kind"]
        text = health_event_text(res, e, cur)
        if k == "health_down":
            on_health(EXIT_DOWN, text)
        elif k == "lease_voided_reboot" and e.get("owner") == owner:
            on_health(EXIT_REBOOTED, text + " (that is you: whatever ran on the device is gone)")
        elif k == "health_degraded" and exit_on_degraded:
            on_health(EXIT_DEGRADED, text)
        elif k in ("health_degraded", "rebooted"):
            say("WARNING: " + text)
        elif k != "lease_voided_reboot":
            say(text)

    w = HealthWatcher(res, hv.get("seq"), on_event)
    w.start()
    return w


def cmd_run(args):
    pos, o, cmd = parse(args, 2, 3, dict({"lease": float, "max-wait": float, "max-hold": float,
                                          "kill-on-preempt": bool, "new-ticket": bool, "on-down": str},
                                         **HEALTH_FLAGS), allow_dashdash=True)
    if not cmd:
        die("usage: hwlock run <resource> <owner> [reason] -- <cmd...>")
    on_down = o.get("on-down", "kill")
    if on_down not in ("kill", "warn"):
        die("--on-down must be kill or warn")
    res, owner = pos[0], pos[1]
    kill = o.get("kill-on-preempt", False)
    import subprocess

    out = acquire_or_exit(res, owner, pos[2] if len(pos) > 2 else None, o.get("lease"), o.get("max-wait"),
                          pid=os.getpid(), max_hold=o.get("max-hold"), new_ticket=o.get("new-ticket", False),
                          fail_if_down=o.get("fail-if-down", False),
                          exit_on_degraded=o.get("exit-on-degraded", False))
    say(acquired_msg(out, owner))
    child = None
    old = {}
    preempted = []
    health_exit = []  # the exit code (6/7/8) once the device's health stopped the command
    terminating = []

    def terminate(after, why=""):
        """SIGTERM the command now, SIGKILL `after` seconds later (once)."""
        if terminating or child is None or child.poll() is not None:
            return
        terminating.append(after)
        say("%sstopping the command (SIGTERM now, SIGKILL in %s if it is still running)" % (why, fmt_s(after)))
        send(signal.SIGTERM)
        t = threading.Timer(after, send, (signal.SIGKILL,))
        t.daemon = True
        t.start()

    def stop_child(why, deadline_s):
        """--kill-on-preempt: SIGTERM now, SIGKILL before the lock goes to the next holder."""
        if preempted:
            return
        preempted.append(why)
        terminate(max(0.0, min(KILL_AFTER_S, deadline_s - 1.0)), "--kill-on-preempt: ")

    def on_refused(p):
        if kill:
            stop_child("over_max_hold", min(p.get("evict_in_s") or 0, p.get("lease_left_s") or 0))
        else:
            preempted.append("over_max_hold")
            say("the command keeps running (no --kill-on-preempt); it must not use %s after that" % res)

    def on_lost(msg):
        if health_exit:
            return  # already handled as a health stop (a voided lease also shows up as a lost renew)
        if kill:
            stop_child("lost", 0)
        elif "lost" not in preempted:
            preempted.append("lost")

    def on_health(code, msg):
        if health_exit:
            return
        if on_down == "warn" and code != EXIT_DEGRADED:
            say("WARNING: %s; the command keeps running (--on-down=warn): check its results" % msg)
            preempted.append("health")
            return
        health_exit.append(code)
        say("WARNING: %s; exit %d" % (msg, code))
        terminate(KILL_AFTER_S)

    renewer = Renewer(res, owner, _lease_of(out, o.get("lease")), (out.get("holder") or {}).get("guard"),
                      on_refused, on_lost)
    watcher = None

    def send(signum):
        if child is not None and child.poll() is None:
            try:
                child.send_signal(signum)
            except OSError:
                pass

    def forward(signum, _frame):
        if signum == signal.SIGINT:
            # A terminal Ctrl-C already reached the child (same process group); only pass SIGINT on
            # if the child is still running a moment later (e.g. `kill -INT` aimed at us alone).
            t = threading.Timer(0.5, send, (signum,))
            t.daemon = True
            t.start()
        else:
            send(signum)

    try:
        for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            old[s] = signal.signal(s, forward)
        try:
            child = subprocess.Popen(cmd)
        except OSError as err:
            say("cannot start %r: %s" % (cmd[0], err))
            return 127
        renewer.start()  # only now: a refusal must find the child to stop
        watcher = _health_watch(res, owner, out, on_health, o.get("exit-on-degraded", False))
        while True:
            try:
                rc = child.wait()
                break
            except KeyboardInterrupt:  # pragma: no cover - handler replaced, kept for safety
                send(signal.SIGINT)
        if health_exit:
            say("command stopped: %s; exit %d" % ({EXIT_DOWN: "the device went down",
                                                   EXIT_REBOOTED: "the device rebooted",
                                                   EXIT_DEGRADED: "the device is degraded"}[health_exit[0]],
                                                  health_exit[0]))
            return health_exit[0]
        if kill and preempted:
            say("command stopped: %s was taken away (max hold exceeded while others wait); exit %d"
                % (res, EXIT_PREEMPTED))
            return EXIT_PREEMPTED
        if preempted:
            say("WARNING: the command ran past %s%s; check its results" % (
                "a health problem of %s" % res if "health" in preempted else
                "the max hold of %s while others waited" % res,
                " and after the lock was gone" if "lost" in preempted or renewer.lost else ""))
        return rc if rc >= 0 else 128 - rc
    finally:
        renewer.stop()
        if watcher:
            watcher.stop()
        for s, h in old.items():
            signal.signal(s, h)
        release(res, owner, quiet=bool(renewer.voided or (health_exit and health_exit[0] == EXIT_REBOOTED)))


def cmd_hold(args):
    pos, o, _ = parse(args, 2, 3, dict({"lease": float, "max-wait": float, "max-hold": float, "until-file": str,
                                        "poll": float, "new-ticket": bool}, **HEALTH_FLAGS))
    if "until-file" not in o:
        die("usage: hwlock hold <resource> <owner> [reason] --until-file F")
    res, owner, until = pos[0], pos[1], o["until-file"]
    out = acquire_or_exit(res, owner, pos[2] if len(pos) > 2 else None, o.get("lease"), o.get("max-wait"),
                          pid=os.getpid(), max_hold=o.get("max-hold"), new_ticket=o.get("new-ticket", False),
                          fail_if_down=o.get("fail-if-down", False),
                          exit_on_degraded=o.get("exit-on-degraded", False))
    say(acquired_msg(out, owner) + "; holding until %s exists" % until)
    stop = threading.Event()
    health_exit = []

    def on_health(code, msg):
        if not health_exit:
            health_exit.append(code)
            say("WARNING: %s; ending the hold (exit %d)" % (msg, code))
            stop.set()

    renewer = Renewer(res, owner, _lease_of(out, o.get("lease")), (out.get("holder") or {}).get("guard"),
                      on_lost=lambda _msg: stop.set())
    renewer.start()
    watcher = _health_watch(res, owner, out, on_health, o.get("exit-on-degraded", False))
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda *_: stop.set())
    try:
        while not os.path.exists(until) and not stop.wait(o.get("poll", 1.0)):
            pass
    except KeyboardInterrupt:
        pass
    finally:
        renewer.stop()
        if watcher:
            watcher.stop()
        voided = renewer.voided or (health_exit and health_exit[0] == EXIT_REBOOTED)
        if not renewer.lost and not voided:
            release(res, owner)
    if health_exit or renewer.voided:
        code = health_exit[0] if health_exit else EXIT_REBOOTED
        say("hold of %s ended: %s; exit %d" % (res, {EXIT_DOWN: "the device is down (lock released)",
                                                    EXIT_REBOOTED: "the device rebooted (lease voided)",
                                                    EXIT_DEGRADED: "the device is degraded (lock released)"}[code],
                                              code))
        return code
    if renewer.lost:
        say("hold of %s ended: the lock is gone (%s); exit %d" % (
            res, "max hold exceeded while others waited" if renewer.over else "lease lost",
            EXIT_PREEMPTED if renewer.over else EXIT_NOT_HOLDER))
        return EXIT_PREEMPTED if renewer.over else EXIT_NOT_HOLDER
    say("released %s" % res)
    return EXIT_OK


def cmd_watch(args):
    """Block until the next health change of <resource> (or until it is in --until STATE), print it and
    exit with its code: 0 up, 6 down, 7 rebooted, 8 degraded; 3 after --timeout. Meant to be started as a
    background command by an agent: its exit is the notification."""
    pos, o, _ = parse(args, 1, 1, {"until": str, "timeout": float, "json": bool})
    res = pos[0]
    until = o.get("until")
    if until is not None and until not in ("up", "down", "degraded", "rebooted"):
        die("--until must be up, down, degraded or rebooted")
    deadline = time.monotonic() + o["timeout"] if "timeout" in o else None
    seq, backoff, said = None, 1.0, None
    while True:
        wait = LONG_POLL_S if seq is not None else 0
        if deadline is not None:
            left = deadline - time.monotonic()
            if left <= 0:
                say("no health change of %s within %ss" % (res, o["timeout"]))
                return EXIT_TIMEOUT
            wait = min(wait, left)
        q = "/r/%s/health" % res + ("?after=%d&wait=%g" % (seq, wait) if seq is not None else "")
        try:
            _, out = call("GET", q, timeout=wait + 15)
            backoff = 1.0
        except ServerError as err:
            if err.status == 404:
                die("no health probes are configured for %s on the server (%s)" % (res, URL), EXIT_SERVER)
            server_error_exit(err)
        except Unreachable as err:
            msg = "server unreachable (%s); retrying" % err
            if msg != said:
                say(msg)
                said = msg
            time.sleep(backoff)
            backoff = min(backoff * 1.5, 5.0)
            continue
        hv = out.get("health") or {}
        if seq is None:
            m = metrics_text(hv.get("metrics"))
            say("watching %s: %s%s" % (res, health_text(res, hv), ("  [" + m + "]") if m else ""))
            seq = int(hv.get("seq") or 0)
            if until is not None and until == hv.get("state"):
                print(json.dumps(out) if o.get("json") else health_text(res, hv))
                return HEALTH_EXIT[until]
            continue
        events = out.get("events") or []
        seq = max(seq, int(hv.get("seq") or 0))
        for e in events:
            say(health_event_text(res, e, hv))
        if not events:
            continue
        kinds = [("rebooted" if e["kind"] in ("rebooted", "lease_voided_reboot") else e["kind"][len("health_"):])
                 for e in events]
        if until is not None:
            if until not in kinds and not (until != "rebooted" and hv.get("state") == until):
                continue
            hit = until
        else:
            hit = "rebooted" if "rebooted" in kinds else kinds[-1]
        if o.get("json"):
            print(json.dumps(out))
        else:
            print("%s %s" % (hit.upper(), health_text(res, hv)))
        return HEALTH_EXIT.get(hit, EXIT_OK)


COMMANDS = {"acquire": cmd_acquire, "renew": cmd_renew, "release": cmd_release, "status": cmd_status,
            "run": cmd_run, "hold": cmd_hold, "events": cmd_events, "watch": cmd_watch,
            "force-release": cmd_force_release}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        sys.stdout.write(__doc__)
        return EXIT_OK if argv and argv[0] in ("-h", "--help", "help") else EXIT_USAGE
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
