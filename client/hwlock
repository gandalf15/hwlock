#!/usr/bin/env python3
"""hwlock - take turns on shared hardware (a Jetson, a GPU box, a robot, a test rig).

One holder per resource, a FIFO queue, leases. Talks to an hwlock server (HWLOCK_URL).
Single file, Python >= 3.8 standard library only: copy it anywhere.

  hwlock acquire <resource> <owner> [reason] [--lease S] [--max-wait S]
  hwlock renew   <resource> <owner> [--lease S]
  hwlock release <resource> <owner>
  hwlock status  [resource] [--json]
  hwlock run     <resource> <owner> [reason] [--lease S] [--max-wait S] -- <cmd...>
  hwlock hold    <resource> <owner> [reason] --until-file F [--lease S] [--max-wait S]
  hwlock events  [resource] [--limit N] [--json]
  hwlock force-release <resource> <by> [reason]          (admin; logged)

acquire waits in FIFO order (long-poll: the server holds each request ~25 s, nobody polls fast),
prints the queue position to stderr while waiting, and exits once you hold the lock. The lease
(default: server's, 1800 s) then runs; `renew` extends it, `release` ends it.
`run` acquires, renews in the background while <cmd> runs, and releases on exit, failure or Ctrl-C.
`hold` acquires and keeps renewing until file F exists (or Ctrl-C), then releases.
Re-acquiring a resource you (same owner) already hold succeeds at once and refreshes the lease.

Env: HWLOCK_URL (default http://127.0.0.1:8770), HWLOCK_TOKEN (bearer token, optional). Without them,
`url=` and `token=` lines in ~/.config/hwlock/config (or $HWLOCK_CONFIG) are used.

Exit codes: 0 ok | 1 not the holder / not held (renew, release, force-release), or renew/re-acquire
refused: held longer than the server's max hold while others wait (OVER_MAX_HOLD) | 2 usage error |
3 gave up after --max-wait | 4 server unreachable or rejected the request (auth, bad input) |
130 interrupted while waiting | run: the command's exit code (128+N if killed by signal N).
"""

import json
import os
import signal
import socket
import sys
import threading
import time
import urllib.error
import urllib.request



def _config():
    """Optional ~/.config/hwlock/config (or $HWLOCK_CONFIG) with `url=...` / `token=...` lines, so
    agents' fresh non-interactive shells find the server without exporting anything. Env wins."""
    path = os.environ.get("HWLOCK_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hwlock", "config")
    conf = {}
    try:
        with open(path) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep and not k.startswith("#"):
                    conf[k.strip().lower()] = v.strip()
    except (OSError, UnicodeDecodeError):
        pass
    return conf


_CONF = _config()
URL = (os.environ.get("HWLOCK_URL") or _CONF.get("url") or "http://127.0.0.1:8770").rstrip("/")
TOKEN = os.environ.get("HWLOCK_TOKEN") or _CONF.get("token") or ""
LONG_POLL_S = float(os.environ.get("HWLOCK_LONG_POLL_S", "25"))
EXIT_OK, EXIT_NOT_HOLDER, EXIT_USAGE, EXIT_TIMEOUT, EXIT_SERVER, EXIT_INT = 0, 1, 2, 3, 4, 130


class ServerError(Exception):
    """HTTP error answer from the server (status, payload)."""

    def __init__(self, status, payload):
        Exception.__init__(self, "%s %s" % (status, payload))
        self.status = status
        self.payload = payload


class Unreachable(Exception):
    pass


def say(msg):
    sys.stderr.write("hwlock: %s\n" % msg)
    sys.stderr.flush()


def die(msg, code=EXIT_USAGE):
    say(msg)
    sys.exit(code)


def call(method, path, body=None, timeout=15.0):
    """Returns (status, payload). Raises ServerError for 4xx/5xx, Unreachable for network errors."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("Connection", "close")
    if TOKEN:
        req.add_header("Authorization", "Bearer " + TOKEN)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as err:
        try:
            payload = json.loads(err.read() or b"{}")
        except ValueError:
            payload = {"error": "http_%d" % err.code}
        raise ServerError(err.code, payload)
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as err:
        raise Unreachable("%s: %s" % (URL, getattr(err, "reason", err)))


def fmt_s(s):
    if s is None:
        return "?"
    s = int(s)
    if abs(s) >= 3600:
        return "%dh%02dm" % (s // 3600, (s % 3600) // 60)
    if abs(s) >= 60:
        return "%dm%02ds" % (s // 60, s % 60)
    return "%ds" % s


def holder_text(h):
    if not h:
        return "free"
    return "%s%s (lease left %s)" % (h["owner"], (": " + h["reason"]) if h.get("reason") else "",
                                    fmt_s(h.get("lease_left_s")))


def server_error_exit(err):
    p = err.payload or {}
    if err.status == 401:
        die("unauthorized: set HWLOCK_TOKEN to the server's token", EXIT_SERVER)
    if err.status == 409 and p.get("error") == "over_max_hold":
        die("%s (evicted in %s)" % (p.get("message"), fmt_s(p.get("evict_in_s"))), EXIT_NOT_HOLDER)
    if err.status == 409:
        die("%s (holder: %s)" % (p.get("message", "not the holder"), holder_text(p.get("holder"))),
            EXIT_NOT_HOLDER)
    die("server said %s: %s" % (err.status, p.get("message", p)), EXIT_SERVER)


class Acquirer(object):
    """Takes a ticket and long-polls until granted. Survives server restarts (re-attaches by ticket)."""

    def __init__(self, resource, owner, reason=None, lease=None, max_wait=None, pid=None):
        self.resource, self.owner, self.reason = resource, owner, reason
        self.lease, self.max_wait = lease, max_wait
        self.pid = pid if pid is not None else os.getppid()
        self.ticket = None
        self.granted = False

    def _body(self, wait):
        b = {"owner": self.owner, "reason": self.reason, "host": socket.gethostname(),
             "pid": self.pid, "wait": wait}
        if self.lease is not None:
            b["lease"] = self.lease
        if self.ticket is not None:
            b["ticket"] = self.ticket
        return b

    def run(self):
        start = time.monotonic()
        last_msg, backoff = None, 1.0
        while True:
            # The first request returns at once with our ticket id, so Ctrl-C can withdraw it and a
            # server restart can be survived by re-attaching with it. Later requests long-poll.
            wait = LONG_POLL_S if self.ticket is not None else 0.0
            if self.max_wait is not None:
                left = self.max_wait - (time.monotonic() - start)
                if left <= 0:
                    self.cancel()
                    die("gave up on %s after %ss (max-wait)" % (self.resource, self.max_wait), EXIT_TIMEOUT)
                wait = max(0.0, min(wait, left))
            try:
                status, out = call("POST", "/r/%s/acquire" % self.resource, self._body(wait),
                                   timeout=wait + 15)
                backoff = 1.0
            except ServerError as err:
                if err.status == 410:
                    say("ticket %s was dropped (we were away too long); rejoining at the back" % self.ticket)
                    self.ticket = None
                    continue
                server_error_exit(err)
            except Unreachable as err:
                msg = "server unreachable (%s); retrying%s" % (
                    err, "" if self.ticket is None else " with ticket %s" % self.ticket)
                if msg != last_msg:
                    say(msg)
                    last_msg = msg
                time.sleep(backoff)
                backoff = min(backoff * 1.5, 5.0)
                continue
            self.ticket = out.get("ticket")
            if out.get("state") == "acquired":
                self.granted = True
                return out
            h = out.get("holder")
            msg = "waiting for %s: position %s of %s, ticket %s, holder %s" % (
                self.resource, out.get("position"), out.get("queue_length"), self.ticket,
                ("%s%s" % (h["owner"], (": " + h["reason"]) if h.get("reason") else "")) if h else "none")
            if msg != last_msg:
                say(msg)
                last_msg = msg

    def cancel(self):
        """Withdraw our ticket (also releases if it was granted in the meantime)."""
        if self.ticket is None:
            return
        try:
            call("POST", "/r/%s/cancel" % self.resource, {"ticket": self.ticket, "owner": self.owner},
                 timeout=5)
        except Exception:
            pass


def acquire_or_exit(resource, owner, reason, lease, max_wait, pid=None):
    acq = Acquirer(resource, owner, reason, lease, max_wait, pid)

    def interrupted(_signum, _frame):
        raise KeyboardInterrupt

    old = signal.signal(signal.SIGTERM, interrupted)
    try:
        return acq.run()
    except KeyboardInterrupt:
        acq.cancel()
        say("interrupted; ticket withdrawn")
        sys.exit(EXIT_INT)
    finally:
        signal.signal(signal.SIGTERM, old)


def release(resource, owner, quiet=False):
    try:
        call("POST", "/r/%s/release" % resource, {"owner": owner})
        return True
    except ServerError as err:
        if not quiet:
            say("release: %s" % (err.payload or {}).get("message", err))
    except Unreachable as err:
        say("release failed, server unreachable (%s); the lease will expire" % err)
    return False


class Renewer(threading.Thread):
    """Renews the lease every lease/3 seconds until stopped."""

    def __init__(self, resource, owner, lease_s):
        threading.Thread.__init__(self, name="hwlock-renew", daemon=True)
        self.resource, self.owner = resource, owner
        self.lease_s = float(lease_s)
        self.stop_ev = threading.Event()
        self.lost = False
        self.over = False

    def run(self):
        interval = max(0.2, self.lease_s / 3.0)
        while not self.stop_ev.wait(interval):
            try:
                call("POST", "/r/%s/renew" % self.resource, {"owner": self.owner, "lease": self.lease_s})
            except ServerError as err:
                p = err.payload or {}
                if err.status == 409 and p.get("error") == "over_max_hold":
                    if not self.over:
                        self.over = True
                        say("WARNING: %s; evicted in %s" % (p.get("message"), fmt_s(p.get("evict_in_s"))))
                elif err.status == 409 and not self.lost:
                    self.lost = True
                    say("WARNING: lost %s (%s)" % (self.resource, (err.payload or {}).get("message")))
            except Unreachable as err:
                say("renew failed (%s); will retry" % err)

    def stop(self):
        self.stop_ev.set()


# ---------------------------------------------------------------------------- argument parsing
def parse(args, positional_min, positional_max, flags, allow_dashdash=False):
    """Tiny parser: returns (positionals, flags dict, rest after --)."""
    pos, opts, rest = [], {}, None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--" and allow_dashdash:
            rest = args[i + 1:]
            break
        if a.startswith("--") and len(a) > 2:
            name, _, val = a[2:].partition("=")
            if name not in flags:
                die("unknown option --%s" % name)
            if flags[name] is bool:
                opts[name] = True
            else:
                if not val:
                    i += 1
                    if i >= len(args):
                        die("--%s needs a value" % name)
                    val = args[i]
                try:
                    opts[name] = flags[name](val)
                except ValueError:
                    die("--%s: bad value %r" % (name, val))
        else:
            pos.append(a)
        i += 1
    if not (positional_min <= len(pos) <= positional_max):
        die("wrong number of arguments; see `hwlock help`")
    return pos, opts, rest


def acquired_msg(out, owner):
    h = out.get("holder") or {}
    return "%s holds %s (lease %s; renew or release)%s" % (
        owner, out.get("resource"), fmt_s(h.get("lease_s")), " [already held: lease refreshed]"
        if out.get("reacquired") else "")


def cmd_acquire(args):
    (res, owner, *rest), o, _ = parse(args, 2, 3, {"lease": float, "max-wait": float})
    out = acquire_or_exit(res, owner, rest[0] if rest else None, o.get("lease"), o.get("max-wait"))
    print("hwlock: " + acquired_msg(out, owner))
    return EXIT_OK


def cmd_renew(args):
    (res, owner), o, _ = parse(args, 2, 2, {"lease": float})
    body = {"owner": owner}
    if "lease" in o:
        body["lease"] = o["lease"]
    try:
        _, out = call("POST", "/r/%s/renew" % res, body)
    except ServerError as err:
        if (err.payload or {}).get("error") == "over_max_hold":
            print("OVER_MAX_HOLD waiting=%s" % err.payload.get("waiting"))
            server_error_exit(err)
        print("NOT_HOLDER holder=%s" % ((err.payload or {}).get("holder") or {}).get("owner", ""))
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    print("RENEWED lease left %s" % fmt_s(out["holder"]["lease_left_s"]))
    return EXIT_OK


def cmd_release(args):
    (res, owner), _, _ = parse(args, 2, 2, {})
    try:
        call("POST", "/r/%s/release" % res, {"owner": owner})
    except ServerError as err:
        print("NOT_HOLDER holder=%s" % ((err.payload or {}).get("holder") or {}).get("owner", ""))
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    print("RELEASED")
    return EXIT_OK


def cmd_status(args):
    pos, o, _ = parse(args, 0, 1, {"json": bool})
    try:
        _, out = call("GET", "/status" + ("/" + pos[0] if pos else ""))
    except ServerError as err:
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    if o.get("json"):
        print(json.dumps(out, indent=2))
        return EXIT_OK
    for r in out.get("resources", [out]):
        h = r["holder"]
        if h:
            print("%s: held by %s  since %s  held %s  lease left %s  host %s pid %s  reason: %s" % (
                r["resource"], h["owner"], time.strftime("%H:%M:%S", time.localtime(h["since"])),
                fmt_s(h["held_s"]), fmt_s(h["lease_left_s"]), h.get("host") or "-", h.get("pid") or "-",
                h.get("reason") or ""))
        else:
            print("%s: free" % r["resource"])
        for q in r["queue"]:
            print("  %d. %s  waiting %s  ticket %s  %s" % (q["position"], q["owner"], fmt_s(q["waiting_s"]),
                                                       q["ticket"], q.get("reason") or ""))
    return EXIT_OK


def cmd_events(args):
    pos, o, _ = parse(args, 0, 1, {"limit": int, "json": bool})
    qs = "?limit=%d" % o.get("limit", 30) + ("&resource=" + pos[0] if pos else "")
    try:
        _, out = call("GET", "/events" + qs)
    except ServerError as err:
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    if o.get("json"):
        print(json.dumps(out, indent=2))
        return EXIT_OK
    for e in out["events"]:
        print("%s  %-14s %-12s %-20s %s" % (time.strftime("%m-%d %H:%M:%S", time.localtime(e["ts"])),
                                           e["kind"], e["resource"] or "", e["owner"] or "",
                                           json.dumps(e["detail"]) if e["detail"] else ""))
    return EXIT_OK


def cmd_force_release(args):
    (res, by, *rest), _, _ = parse(args, 2, 3, {})
    try:
        _, out = call("POST", "/r/%s/force-release" % res, {"by": by, "reason": rest[0] if rest else None})
    except ServerError as err:
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    print("FORCE_RELEASED (was %s)" % out.get("previous_holder"))
    return EXIT_OK


def _lease_of(out, requested):
    return requested or (out.get("holder") or {}).get("lease_s") or 1800


def cmd_run(args):
    pos, o, cmd = parse(args, 2, 3, {"lease": float, "max-wait": float}, allow_dashdash=True)
    if not cmd:
        die("usage: hwlock run <resource> <owner> [reason] -- <cmd...>")
    res, owner = pos[0], pos[1]
    import subprocess

    out = acquire_or_exit(res, owner, pos[2] if len(pos) > 2 else None, o.get("lease"), o.get("max-wait"),
                          pid=os.getpid())
    say(acquired_msg(out, owner))
    renewer = Renewer(res, owner, _lease_of(out, o.get("lease")))
    renewer.start()
    child = None
    old = {}

    def send(signum):
        if child is not None and child.poll() is None:
            try:
                child.send_signal(signum)
            except OSError:
                pass

    def forward(signum, _frame):
        if signum == signal.SIGINT:
            # A terminal Ctrl-C already reached the child (same process group); only pass SIGINT on
            # if the child is still running a moment later (e.g. `kill -INT` aimed at us alone).
            t = threading.Timer(0.5, send, (signum,))
            t.daemon = True
            t.start()
        else:
            send(signum)

    try:
        for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            old[s] = signal.signal(s, forward)
        try:
            child = subprocess.Popen(cmd)
        except OSError as err:
            say("cannot start %r: %s" % (cmd[0], err))
            return 127
        while True:
            try:
                rc = child.wait()
                break
            except KeyboardInterrupt:  # pragma: no cover - handler replaced, kept for safety
                send(signal.SIGINT)
        return rc if rc >= 0 else 128 - rc
    finally:
        renewer.stop()
        for s, h in old.items():
            signal.signal(s, h)
        release(res, owner)


def cmd_hold(args):
    pos, o, _ = parse(args, 2, 3, {"lease": float, "max-wait": float, "until-file": str, "poll": float})
    if "until-file" not in o:
        die("usage: hwlock hold <resource> <owner> [reason] --until-file F")
    res, owner, until = pos[0], pos[1], o["until-file"]
    out = acquire_or_exit(res, owner, pos[2] if len(pos) > 2 else None, o.get("lease"), o.get("max-wait"),
                          pid=os.getpid())
    say(acquired_msg(out, owner) + "; holding until %s exists" % until)
    renewer = Renewer(res, owner, _lease_of(out, o.get("lease")))
    renewer.start()
    stop = threading.Event()
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda *_: stop.set())
    try:
        while not os.path.exists(until) and not stop.wait(o.get("poll", 1.0)):
            pass
    except KeyboardInterrupt:
        pass
    finally:
        renewer.stop()
        release(res, owner)
    say("released %s" % res)
    return EXIT_OK


COMMANDS = {"acquire": cmd_acquire, "renew": cmd_renew, "release": cmd_release, "status": cmd_status,
            "run": cmd_run, "hold": cmd_hold, "events": cmd_events, "force-release": cmd_force_release}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        sys.stdout.write(__doc__)
        return EXIT_OK if argv and argv[0] in ("-h", "--help", "help") else EXIT_USAGE
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
