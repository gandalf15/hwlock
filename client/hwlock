#!/usr/bin/env python3
"""hwlock - take turns on shared hardware (a Jetson, a GPU box, a robot, a test rig).

One holder per resource, a FIFO queue, leases. Talks to an hwlock server (HWLOCK_URL).
Single file, Python >= 3.8 standard library only: copy it anywhere.

  hwlock acquire <resource> <owner> [reason] [--lease S] [--max-wait S] [--max-hold S] [--new-ticket]
  hwlock renew   <resource> <owner> [--lease S]
  hwlock release <resource> <owner>
  hwlock status  [resource] [--json]
  hwlock run     <resource> <owner> [reason] [--lease S] [--max-wait S] [--max-hold S]
                 [--new-ticket] [--kill-on-preempt] -- <cmd...>
  hwlock hold    <resource> <owner> [reason] --until-file F [--lease S] [--max-wait S] [--max-hold S]
                 [--new-ticket]
  hwlock events  [resource] [--limit N] [--json]
  hwlock watch   <resource> [--until STATE] [--timeout S] [--json]
  hwlock force-release <resource> <by> [reason]          (admin; logged)
acquire/run/hold also take: --fail-if-down --exit-on-degraded; run also: --on-down kill|warn

acquire waits in FIFO order (long-poll: the server holds each request ~25 s, nobody polls fast),
prints the queue position to stderr while waiting, and exits once you hold the lock. The lease
(default: server's, 1800 s) then runs; `renew` extends it, `release` ends it.
`run` acquires, renews in the background while <cmd> runs, and releases on exit, failure or Ctrl-C.
`hold` acquires and keeps renewing until file F exists (or Ctrl-C), then releases.
Re-acquiring a resource you (same owner) already hold succeeds at once and refreshes the lease.

Keeping your place: SIGTERM while waiting (a tool timeout, `timeout`, `kill`) keeps the ticket: it
turns dormant on the server for its re-attach window (HWLOCK_REATTACH_S, default 120 s) and the
client exits 143. Re-running the same acquire (same resource and owner) within that window re-attaches
to it and gets its place back. A dormant ticket is skipped while dormant, so it never blocks anyone.
Ctrl-C (SIGINT) gives the place up (the ticket is cancelled, exit 130). --new-ticket drops any old
ticket of this owner and joins at the back. Two clients waiting at once with the same owner share
one ticket (and both get the lock): use a unique owner per job.

Starvation guard (server HWLOCK_MAX_HOLD_S, default 2 h): while others wait, nobody may keep a
resource longer than that from when they took it. Past it, renew/re-acquire is refused
(OVER_MAX_HOLD, exit 5) and after the server's grace period (default 300 s) the next waiter gets
it. Nobody waiting = no limit. --max-hold S asks for a shorter limit for this hold.
`run` and `hold` stop renewing when refused and say so. `run` lets the command go on by default
(it may still be running when the next holder starts: you are warned); with --kill-on-preempt it
sends SIGTERM (SIGKILL 10 s later) so the command is gone before the eviction, and exits 5.
`hold` exits 5 once the lock is gone.

Hardware health (resources with probes on the server): the server checks the device every few
seconds and tells waiting and holding clients at once when it goes DOWN, comes back, is DEGRADED (e.g.
low memory, hot) or REBOOTED (boot id changed: the holder's lease is voided, waiters keep their place).
While a device is down nobody is granted it; `acquire` keeps waiting and prints the state
(--fail-if-down: exit 6 instead). `run` stops the command (SIGTERM, SIGKILL 10 s later) when the device
goes down (exit 6) or reboots (exit 7); --on-down=warn only warns. `hold` exits 6/7. Degraded is a
warning; --exit-on-degraded treats it like down but exits 8. `watch` blocks until the next health
change (or until --until STATE) and exits with its code: run it as a background command to be notified.

Env: HWLOCK_URL (default http://127.0.0.1:8770), HWLOCK_TOKEN (bearer token, optional). Without them,
`url=` and `token=` lines in ~/.config/hwlock/config (or $HWLOCK_CONFIG) are used.

Exit codes: 0 ok | 1 not the holder / not held (renew, release, force-release) | 2 usage error |
3 gave up after --max-wait | 4 server unreachable or rejected the request (auth, bad input) |
5 OVER_MAX_HOLD: renew/re-acquire refused, held past the max hold while others wait; `hold` lost the
lock that way; `run --kill-on-preempt` stopped the command | 130 Ctrl-C while waiting (ticket
cancelled) | 143 SIGTERM while waiting (ticket kept for re-attach) |
6 the device is DOWN (acquire --fail-if-down; run/hold stopped; watch saw it go down) |
7 the device REBOOTED (your lease was voided: re-check your setup on it; watch saw a reboot) |
8 the device is DEGRADED (--exit-on-degraded; watch saw it degrade) |
run: the command's exit code (128+N if killed by signal N), or 6/7/8 when it was stopped for health.
watch: 0 back up, 6 down, 7 rebooted, 8 degraded, 3 --timeout passed.
"""

import json
import os
import signal
import socket
import sys
import threading
import time
import urllib.error
import urllib.request



def _config():
    """Optional ~/.config/hwlock/config (or $HWLOCK_CONFIG) with `url=...` / `token=...` lines, so
    agents' fresh non-interactive shells find the server without exporting anything. Env wins."""
    path = os.environ.get("HWLOCK_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hwlock", "config")
    conf = {}
    try:
        with open(path) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep and not k.startswith("#"):
                    conf[k.strip().lower()] = v.strip()
    except (OSError, UnicodeDecodeError):
        pass
    return conf


_CONF = _config()
URL = (os.environ.get("HWLOCK_URL") or _CONF.get("url") or "http://127.0.0.1:8770").rstrip("/")
TOKEN = os.environ.get("HWLOCK_TOKEN") or _CONF.get("token") or ""
LONG_POLL_S = float(os.environ.get("HWLOCK_LONG_POLL_S", "25"))
EXIT_OK, EXIT_NOT_HOLDER, EXIT_USAGE, EXIT_TIMEOUT, EXIT_SERVER, EXIT_PREEMPTED, EXIT_INT = 0, 1, 2, 3, 4, 5, 130
EXIT_TERM = 143
EXIT_DOWN, EXIT_REBOOTED, EXIT_DEGRADED = 6, 7, 8
KILL_AFTER_S = 10.0  # run --kill-on-preempt: SIGTERM, then SIGKILL this much later


class ServerError(Exception):
    """HTTP error answer from the server (status, payload)."""

    def __init__(self, status, payload):
        Exception.__init__(self, "%s %s" % (status, payload))
        self.status = status
        self.payload = payload


class Unreachable(Exception):
    pass


class Terminated(BaseException):
    """SIGTERM while waiting (BaseException: must not be swallowed as a network error)."""


def say(msg):
    sys.stderr.write("hwlock: %s\n" % msg)
    sys.stderr.flush()


def die(msg, code=EXIT_USAGE):
    say(msg)
    sys.exit(code)


def call(method, path, body=None, timeout=15.0):
    """Returns (status, payload). Raises ServerError for 4xx/5xx, Unreachable for network errors."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("Connection", "close")
    if TOKEN:
        req.add_header("Authorization", "Bearer " + TOKEN)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as err:
        try:
            payload = json.loads(err.read() or b"{}")
        except ValueError:
            payload = {"error": "http_%d" % err.code}
        raise ServerError(err.code, payload)
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as err:
        raise Unreachable("%s: %s" % (URL, getattr(err, "reason", err)))


def fmt_s(s):
    if s is None:
        return "?"
    s = int(s)
    if abs(s) >= 3600:
        return "%dh%02dm" % (s // 3600, (s % 3600) // 60)
    if abs(s) >= 60:
        return "%dm%02ds" % (s // 60, s % 60)
    return "%ds" % s


def holder_text(h):
    if not h:
        return "free"
    return "%s%s (lease left %s)" % (h["owner"], (": " + h["reason"]) if h.get("reason") else "",
                                    fmt_s(h.get("lease_left_s")))


def metrics_text(m):
    """The exporter's main numbers, short (for status and watch)."""
    if not isinstance(m, dict):
        return ""
    bits = []
    if isinstance(m.get("mem_available_mb"), (int, float)):
        bits.append("mem free %.0f%s MB" % (m["mem_available_mb"], "/%.0f" % m["mem_total_mb"]
                                            if isinstance(m.get("mem_total_mb"), (int, float)) else ""))
    if isinstance(m.get("load1"), (int, float)):
        bits.append("load %.2f" % m["load1"])
    if isinstance(m.get("temp_max_c"), (int, float)):
        bits.append("max %.0f C" % m["temp_max_c"])
    if isinstance(m.get("gpu_load_pct"), (int, float)):
        bits.append("GPU %.0f%%" % m["gpu_load_pct"])
    if isinstance(m.get("uptime_s"), (int, float)):
        bits.append("up %s" % fmt_s(m["uptime_s"]))
    if m.get("nvpmodel"):
        bits.append(str(m["nvpmodel"]))
    return ", ".join(bits)


def health_text(res, hv):
    """'jetson is DOWN (for 12s): ssh_banner ...: TCP accepted but no SSH banner'"""
    s = "%s is %s" % (res, str(hv.get("state", "unknown")).upper())
    if hv.get("for_s") is not None:
        s += " (for %s)" % fmt_s(hv["for_s"])
    if hv.get("reason"):
        s += ": %s" % hv["reason"]
    return s


HEALTH_EXIT = {"down": EXIT_DOWN, "degraded": EXIT_DEGRADED, "rebooted": EXIT_REBOOTED, "up": EXIT_OK,
               "unknown": EXIT_OK}


def voided_exit(p):
    """409 not_holder because the device rebooted (the server voided the lease): exit 7."""
    v = p.get("voided") or {}
    print("VOIDED_REBOOT booted_at=%s" % time.strftime("%H:%M:%S", time.localtime(v.get("booted_at") or v.get("at") or 0)))
    die("%s. Whatever you set up on the device is gone: acquire again and re-check your setup before"
        " going on" % p.get("message"), EXIT_REBOOTED)


def server_error_exit(err):
    p = err.payload or {}
    if err.status == 409 and p.get("voided"):
        voided_exit(p)
    if err.status == 401:
        die("unauthorized: set HWLOCK_TOKEN to the server's token", EXIT_SERVER)
    if err.status == 409 and p.get("error") == "over_max_hold":
        die("OVER_MAX_HOLD: %s (evicted in %s)" % (p.get("message"), fmt_s(p.get("evict_in_s"))),
            EXIT_PREEMPTED)
    if err.status == 409:
        die("%s (holder: %s)" % (p.get("message", "not the holder"), holder_text(p.get("holder"))),
            EXIT_NOT_HOLDER)
    die("server said %s: %s" % (err.status, p.get("message", p)), EXIT_SERVER)


class Acquirer(object):
    """Takes a ticket and long-polls until granted. Survives server restarts (re-attaches by ticket)."""

    def __init__(self, resource, owner, reason=None, lease=None, max_wait=None, pid=None, max_hold=None,
                 new_ticket=False, fail_if_down=False, exit_on_degraded=False):
        self.resource, self.owner, self.reason = resource, owner, reason
        self.fail_if_down, self.exit_on_degraded = fail_if_down, exit_on_degraded
        self.health = None  # the device's health from the last answer (None: no probes on the server)
        self.lease, self.max_wait, self.max_hold = lease, max_wait, max_hold
        self.new_ticket = new_ticket  # only on the first request: drop our old ticket, join at the back
        self.pid = pid if pid is not None else os.getppid()
        self.ticket = None
        self.granted = False
        # this process's id for the server: after a re-run of the same acquire re-attaches to our ticket,
        # a late cancel/detach from this (old) process no longer touches the re-run's ticket or grant
        self.attach = os.urandom(8).hex()

    def _body(self, wait):
        b = {"owner": self.owner, "reason": self.reason, "host": socket.gethostname(),
             "pid": self.pid, "wait": wait, "attach": self.attach}
        if self.lease is not None:
            b["lease"] = self.lease
        if self.max_hold is not None:
            b["max_hold"] = self.max_hold
        if self.ticket is not None:
            b["ticket"] = self.ticket
        elif self.new_ticket:
            b["new_ticket"] = True
        return b

    def run(self):
        start = time.monotonic()
        last_msg, backoff = None, 1.0
        while True:
            # The first request returns at once with our ticket id, so Ctrl-C can withdraw it and a
            # server restart can be survived by re-attaching with it. Later requests long-poll.
            wait = LONG_POLL_S if self.ticket is not None else 0.0
            if self.max_wait is not None:
                left = self.max_wait - (time.monotonic() - start)
                if left <= 0:
                    self.cancel()
                    die("gave up on %s after %ss (max-wait)" % (self.resource, self.max_wait), EXIT_TIMEOUT)
                wait = max(0.0, min(wait, left))
            try:
                status, out = call("POST", "/r/%s/acquire" % self.resource, self._body(wait),
                                   timeout=wait + 15)
                backoff = 1.0
            except ServerError as err:
                if err.status == 410:
                    say("ticket %s was dropped (we were away too long); rejoining at the back" % self.ticket)
                    self.ticket = None
                    continue
                server_error_exit(err)
            except Unreachable as err:
                msg = "server unreachable (%s); retrying%s" % (
                    err, "" if self.ticket is None else " with ticket %s" % self.ticket)
                if msg != last_msg:
                    say(msg)
                    last_msg = msg
                time.sleep(backoff)
                backoff = min(backoff * 1.5, 5.0)
                continue
            if self.ticket is None and out.get("reattached"):
                say("re-attached to ticket %s (kept its place in the queue)" % out.get("ticket"))
            self.new_ticket = False
            self.ticket = out.get("ticket")
            self._on_health(out)
            if out.get("state") == "acquired":
                self.granted = True
                return out
            h = out.get("holder")
            msg = "waiting for %s: position %s of %s, ticket %s, holder %s%s%s" % (
                self.resource, out.get("position"), out.get("queue_length"), self.ticket,
                ("%s%s" % (h["owner"], (": " + h["reason"]) if h.get("reason") else "")) if h else "none",
                " (%s dormant ticket(s) ahead, skipped unless re-attached)" % out["dormant_ahead"]
                if out.get("dormant_ahead") else "",
                "; nobody gets it while it is DOWN" if (out.get("health") or {}).get("state") == "down" else "")
            if msg != last_msg:
                say(msg)
                last_msg = msg

    def _on_health(self, out):
        """Tell the user about the device's health as soon as an answer shows a change (the server ends a
        long-poll early on every health event), and give up if asked to (--fail-if-down, --exit-on-degraded)."""
        hv = out.get("health")
        if not hv:
            return
        prev, self.health = self.health, hv
        waiting = out.get("state") == "waiting"
        if prev is not None and hv.get("last_reboot") and hv.get("last_reboot") != prev.get("last_reboot"):
            say("WARNING: %s REBOOTED (boot id changed)%s" % (
                self.resource, "; your place in the queue is kept. Re-check what you need on it once you hold it"
                if waiting else ""))
        if prev is None or prev.get("state") != hv["state"]:
            st = hv["state"]
            if st == "down":
                say("WARNING: %s; nobody is granted it until it is back. %s" % (
                    health_text(self.resource, hv), "Still waiting (--fail-if-down gives up)." if waiting
                    and not self.fail_if_down else ""))
            elif st == "degraded":
                say("WARNING: %s" % health_text(self.resource, hv))
            elif prev is not None:
                say("%s is %s again" % (self.resource, st.upper()))
        if waiting and hv["state"] == "down" and self.fail_if_down:
            self.cancel()
            die("%s; gave up (--fail-if-down), ticket withdrawn" % health_text(self.resource, hv), EXIT_DOWN)
        if waiting and hv["state"] == "degraded" and self.exit_on_degraded:
            self.cancel()
            die("%s; gave up (--exit-on-degraded), ticket withdrawn" % health_text(self.resource, hv),
                EXIT_DEGRADED)

    def cancel(self):
        """Withdraw our ticket (also releases if it was granted in the meantime)."""
        if self.ticket is None:
            return
        try:
            call("POST", "/r/%s/cancel" % self.resource,
                 {"ticket": self.ticket, "owner": self.owner, "attach": self.attach}, timeout=5)
        except Exception:
            pass

    def detach(self):
        """Keep our place: the server makes our ticket dormant for its re-attach window (also releases
        if it was granted in the meantime). Without a ticket id yet, detach by owner (never releases)."""
        body = {"owner": self.owner, "attach": self.attach}
        if self.ticket is not None:
            body["ticket"] = self.ticket
        try:
            _, out = call("POST", "/r/%s/detach" % self.resource, body, timeout=3)
            return out
        except BaseException:
            return None


def acquire_or_exit(resource, owner, reason, lease, max_wait, pid=None, max_hold=None, new_ticket=False,
                    fail_if_down=False, exit_on_degraded=False):
    acq = Acquirer(resource, owner, reason, lease, max_wait, pid, max_hold, new_ticket, fail_if_down,
                   exit_on_degraded)

    def terminated(_signum, _frame):
        raise Terminated()

    old = signal.signal(signal.SIGTERM, terminated)
    try:
        out = acq.run()
        hv = out.get("health") or {}
        if hv.get("state") == "degraded" and exit_on_degraded:
            release(resource, owner, quiet=True)
            die("%s; released again (--exit-on-degraded)" % health_text(resource, hv), EXIT_DEGRADED)
        return out
    except KeyboardInterrupt:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        acq.cancel()
        say("interrupted; ticket withdrawn")
        sys.exit(EXIT_INT)
    except Terminated:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)  # a second TERM must not cut the detach short
        out = acq.detach() or {}
        if out.get("state") == "released":
            say("terminated (SIGTERM); the lock had just been granted and is released again")
        elif out.get("state") == "dormant":
            say("terminated (SIGTERM); ticket %s kept for %s: re-run the same acquire (same resource and"
                " owner) within that time to get your place back (Ctrl-C would have given it up)"
                % (out.get("ticket"), fmt_s(out.get("window_s"))))
        elif out.get("state") == "superseded":
            say("terminated (SIGTERM); a newer run of this acquire (same owner) already took over ticket %s"
                % out.get("ticket"))
        else:
            say("terminated (SIGTERM); ticket %s kept if the server saw it: re-run the same acquire soon"
                " to get your place back" % acq.ticket)
        sys.exit(EXIT_TERM)
    finally:
        signal.signal(signal.SIGTERM, old)


def release(resource, owner, quiet=False):
    try:
        call("POST", "/r/%s/release" % resource, {"owner": owner})
        return True
    except ServerError as err:
        if not quiet:
            say("release: %s" % (err.payload or {}).get("message", err))
    except Unreachable as err:
        say("release failed, server unreachable (%s); the lease will expire" % err)
    return False


class Renewer(threading.Thread):
    """Keeps the lease alive (renew every lease/3) until stopped, and watches the starvation guard.

    While the server reports a max hold, it looks at the status at least every grace/3 (a cheap GET, not a
    renew) and renews right after the refusal point once others wait, so a refusal is noticed well before
    the eviction. After a refusal
    (OVER_MAX_HOLD) it stops renewing for good and only checks every few seconds whether the lock is
    still ours. Callbacks: on_refused(payload) once, on_lost(message) once.
    """

    def __init__(self, resource, owner, lease_s, guard=None, on_refused=None, on_lost=None):
        threading.Thread.__init__(self, name="hwlock-renew", daemon=True)
        self.resource, self.owner = resource, owner
        self.lease_s = float(lease_s)
        self.stop_ev = threading.Event()
        self.lost = False
        self.voided = None  # the server's "voided" detail when the lease ended because the device rebooted
        self.over = None  # the server's over_max_hold payload once a renew was refused
        self.guard = guard  # the holder's "guard" from the last answer (acquire, renew or status)
        self.next_renew = time.monotonic() + max(0.2, self.lease_s / 3.0)
        self.on_refused, self.on_lost = on_refused, on_lost

    def _refusal_due(self):
        g = self.guard or {}
        return "refuse_in_s" in g and g["refuse_in_s"] <= 0

    def _next_wait(self):
        wait = max(0.2, self.next_renew - time.monotonic())
        g = self.guard
        if self.over is not None:
            return min(wait, 2.0)  # not renewing any more: just watch for the loss
        if g:
            wait = min(wait, max(0.2, g.get("grace_s", wait) / 3.0))
            if "refuse_in_s" in g and g["refuse_in_s"] > 0:
                wait = min(wait, g["refuse_in_s"] + 0.2)
        return wait

    def _lose(self, msg):
        if not self.lost:
            self.lost = True
            say("WARNING: lost %s (%s)" % (self.resource, msg))
            if self.on_lost:
                self.on_lost(msg)

    def _watch(self):
        """Is the lock still ours? Also refreshes the guard (waiters, deadlines) without renewing."""
        try:
            _, st = call("GET", "/status/%s" % self.resource)
        except (ServerError, Unreachable):
            return
        h = st.get("holder") or {}
        if h.get("owner") != self.owner:
            if self.over is not None:
                self._lose("evicted for the next in line after the max hold" if h else "lease ran out")
            else:
                self._lose("now held by %s" % h["owner"] if h else "lease ran out")
        else:
            self.guard = h.get("guard")

    def run(self):
        while not self.lost and not self.stop_ev.wait(self._next_wait()):
            if self.over is not None or (time.monotonic() < self.next_renew and not self._refusal_due()):
                self._watch()
                if self.over is not None or not self._refusal_due():
                    continue
            try:
                _, out = call("POST", "/r/%s/renew" % self.resource, {"owner": self.owner, "lease": self.lease_s})
                self.guard = (out.get("holder") or {}).get("guard")
                self.next_renew = time.monotonic() + max(0.2, self.lease_s / 3.0)
            except ServerError as err:
                p = err.payload or {}
                if err.status == 409 and p.get("error") == "over_max_hold":
                    self.over = p
                    say("WARNING: OVER_MAX_HOLD: %s. Not renewing any more; the next in line gets %s in %s,"
                        " or sooner when the lease runs out (%s left). Finish up and release."
                        % (p.get("message"), self.resource, fmt_s(p.get("evict_in_s")),
                           fmt_s(p.get("lease_left_s"))))
                    if self.on_refused:
                        self.on_refused(p)
                elif err.status == 409:
                    self.voided = p.get("voided")
                    self._lose(p.get("message"))
            except Unreachable as err:
                say("renew failed (%s); will retry" % err)

    def stop(self):
        self.stop_ev.set()


class HealthWatcher(threading.Thread):
    """For run/hold: long-polls GET /r/<res>/health?after=SEQ, so a holder learns at once that its device
    went down, rebooted (lease voided) or degraded, instead of at the next renew. on_event(event, health)
    is called for each health event in order. Quietly ends if the server has no probes for the resource."""

    def __init__(self, resource, seq, on_event):
        threading.Thread.__init__(self, name="hwlock-health", daemon=True)
        self.resource, self.seq, self.on_event = resource, int(seq or 0), on_event
        self.stop_ev = threading.Event()

    def run(self):
        backoff = 1.0
        while not self.stop_ev.is_set():
            try:
                _, out = call("GET", "/r/%s/health?after=%d&wait=%g" % (self.resource, self.seq, LONG_POLL_S),
                              timeout=LONG_POLL_S + 15)
                backoff = 1.0
            except ServerError as err:
                if err.status == 404:
                    return
                self.stop_ev.wait(backoff)
                backoff = min(backoff * 1.5, 5.0)
                continue
            except Unreachable:
                self.stop_ev.wait(backoff)
                backoff = min(backoff * 1.5, 5.0)
                continue
            hv = out.get("health") or {}
            for e in out.get("events") or []:
                if self.stop_ev.is_set():
                    return
                self.on_event(e, hv)
            self.seq = max(self.seq, int(hv.get("seq") or 0))

    def stop(self):
        self.stop_ev.set()


def health_event_text(res, e, hv):
    d = e.get("detail") or {}
    k = e["kind"]
    if k == "rebooted":
        return "%s REBOOTED (boot id changed; booted %s)" % (
            res, time.strftime("%H:%M:%S", time.localtime(d["booted_at"])) if d.get("booted_at") else "?")
    if k == "lease_voided_reboot":
        return "%s rebooted: the lease of %s was voided" % (res, e.get("owner"))
    st = k[len("health_"):] if k.startswith("health_") else k
    return "%s is %s%s" % (res, st.upper(), (": " + d["reason"]) if d.get("reason") else "")


# ---------------------------------------------------------------------------- argument parsing
def parse(args, positional_min, positional_max, flags, allow_dashdash=False):
    """Tiny parser: returns (positionals, flags dict, rest after --)."""
    pos, opts, rest = [], {}, None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--" and allow_dashdash:
            rest = args[i + 1:]
            break
        if a.startswith("--") and len(a) > 2:
            name, _, val = a[2:].partition("=")
            if name not in flags:
                die("unknown option --%s" % name)
            if flags[name] is bool:
                opts[name] = True
            else:
                if not val:
                    i += 1
                    if i >= len(args):
                        die("--%s needs a value" % name)
                    val = args[i]
                try:
                    opts[name] = flags[name](val)
                except ValueError:
                    die("--%s: bad value %r" % (name, val))
        else:
            pos.append(a)
        i += 1
    if not (positional_min <= len(pos) <= positional_max):
        die("wrong number of arguments; see `hwlock help`")
    return pos, opts, rest


def acquired_msg(out, owner):
    h = out.get("holder") or {}
    g = h.get("guard")
    return "%s holds %s (lease %s; renew or release%s)%s" % (
        owner, out.get("resource"), fmt_s(h.get("lease_s")),
        "; max hold %s while others wait" % fmt_s(g["max_hold_s"]) if g else "",
        " [already held: lease refreshed]" if out.get("reacquired") else "")


def guard_text(g):
    """Starvation-guard deadlines for `status` (only while others wait)."""
    if not g or "evict_in_s" not in g:
        return ""
    return "  max hold %s: %s, evicted in %s" % (
        fmt_s(g["max_hold_s"]), "RENEW REFUSED" if g["refuse_in_s"] <= 0 else
        "renew refused in %s" % fmt_s(g["refuse_in_s"]), fmt_s(max(0, g["evict_in_s"])))


def cmd_acquire(args):
    (res, owner, *rest), o, _ = parse(args, 2, 3, dict({"lease": float, "max-wait": float, "max-hold": float,
                                                        "new-ticket": bool}, **HEALTH_FLAGS))
    out = acquire_or_exit(res, owner, rest[0] if rest else None, o.get("lease"), o.get("max-wait"),
                          max_hold=o.get("max-hold"), new_ticket=o.get("new-ticket", False),
                          fail_if_down=o.get("fail-if-down", False),
                          exit_on_degraded=o.get("exit-on-degraded", False))
    print("hwlock: " + acquired_msg(out, owner))
    return EXIT_OK


def cmd_renew(args):
    (res, owner), o, _ = parse(args, 2, 2, {"lease": float})
    body = {"owner": owner}
    if "lease" in o:
        body["lease"] = o["lease"]
    try:
        _, out = call("POST", "/r/%s/renew" % res, body)
    except ServerError as err:
        if (err.payload or {}).get("error") == "over_max_hold":
            print("OVER_MAX_HOLD waiting=%s evict_in=%s" % (err.payload.get("waiting"),
                                                           int(err.payload.get("evict_in_s") or 0)))
            server_error_exit(err)
        if not (err.payload or {}).get("voided"):
            print("NOT_HOLDER holder=%s" % ((err.payload or {}).get("holder") or {}).get("owner", ""))
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    print("RENEWED lease left %s" % fmt_s(out["holder"]["lease_left_s"]))
    hv = out.get("health") or {}
    if hv.get("state") in ("down", "degraded"):
        say("WARNING: %s" % health_text(res, hv))
    return EXIT_OK


def cmd_release(args):
    (res, owner), _, _ = parse(args, 2, 2, {})
    try:
        call("POST", "/r/%s/release" % res, {"owner": owner})
    except ServerError as err:
        if not (err.payload or {}).get("voided"):
            print("NOT_HOLDER holder=%s" % ((err.payload or {}).get("holder") or {}).get("owner", ""))
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    print("RELEASED")
    return EXIT_OK


def cmd_status(args):
    pos, o, _ = parse(args, 0, 1, {"json": bool})
    try:
        _, out = call("GET", "/status" + ("/" + pos[0] if pos else ""))
    except ServerError as err:
        server_error_exit(err)
    except Unreachable as err:
        die(str(err), EXIT_SERVER)
    if o.get("json"):
        print(json.dumps(out, indent=2))
        return EXIT_OK
    for r in out.get("resources", [out]):
        hv = r.get("health")
        if hv:
            m = metrics_text(hv.get("metrics"))
            print("%s: health %s for %s%s%s%s" % (
                r["resource"], hv["state"].upper(), fmt_s(hv.get("for_s")),
                (": " + hv["reason"]) if hv.get("reason") and hv["state"] != "up" else "",
                ("  [" + m + "]") if m else "",
                ("  checked %s ago" % fmt_s(hv["checked_s_ago"])) if hv.get("checked_s_ago") is not None else ""))
            if hv.get("last_reboot"):
                print("  last reboot %s" % time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(hv["last_reboot"])))
        h = r["holder"]
        if h:
            print("%s: held by %s  since %s  held %s  lease left %s  host %s pid %s  reason: %s%s" % (
                r["resource"], h["owner"], time.strftime("%H:%M:%S", time.localtime(h["since"])),
                fmt_s(h["held_s"]), fmt_s(h["lease_left_s"]), h.get("host") or "-", h.get("pid") or "-",
                h.get("reason") or "", guard_text(h.get("guard"))))
        else:
            print("%s: free" % r["resource"])
        for q in r["queue"]:
            print("  %d. %s  waiting %s  ticket %s  %s" % (q["position"], q["owner"], fmt_s(q["waiting_s"]),
                                                       q["ticket"], q.get("reason") or ""))
        for d in r.get("dormant") or []:
            print("  -  %s  DORMANT (client gone; re-attach within %s to get place %s back)  ticket %s  %s" % (
                d["owner"], fmt_s(max(0, d["dormant_left_s"])), d["position_on_reattach"], d["ticket"],
                d.get("reason") or ""))
    return EXIT_OK


def cmd_events(args):
    pos, o, _ = parse(args, 0, 1, {"limit": int, "json": bool})
    qs = "?limit=%d" % o.get("limit", 30) + ("&resource=" + pos[0] if pos else "")
